NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://beautyflow:beautyflow_dev@localhost:5433/beautyflow?schema=public
TEST_DATABASE_URL=postgresql://beautyflow:beautyflow_dev@localhost:5433/beautyflow_test?schema=public
POSTGRES_PORT=5433
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true
TRUST_PROXY=0
LOG_LEVEL=info
PROVIDER_PHOTO_UPLOAD_DIR=./uploads/provider-photos
PROVIDER_PHOTO_MAX_BYTES=5242880
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your-amazon-ses-smtp-username
SMTP_PASSWORD=your-amazon-ses-smtp-password
SMTP_FROM=verified-sender@example.com
MAIL_FROM_NAME=BeautyFlow
APP_PUBLIC_URL=http://localhost:3001
INVITATION_EXPIRY_HOURS=48
SEED_SUPER_ADMIN_EMAIL=admin@beautyflow.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_RECEPTIONIST_EMAIL=receptionist@example.com
SEED_RECEPTIONIST_PASSWORD=ChangeMe123!
SEED_PROVIDER_EMAIL=provider@example.com
SEED_PROVIDER_PASSWORD=ChangeMe123!
